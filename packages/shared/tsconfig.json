{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@commitflow/config-typescript/node-library.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "incremental": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
